class Solution {
    public int removeElement(int[] nums, int val) {
       int cnt=0;
       for(int x: nums){
        if(x!=val){
            cnt++;
        }
       }

        for(int i=0;i<nums.length;i++){
            if(nums[i]==val){
                nums[i]=101;                    
            }
        }
        Arrays.sort(nums);
       return cnt;
    }
}
