class Solution {
    public int missingNumber(int[] nums) {
        int missing=0;
        ArrayList<Integer> ht = new ArrayList<>();
        for(int x: nums){
            ht.add(x);
        }
        for(int i=0;i<=nums.length;i++){
            if(ht.contains(i)==false){
                missing=i;
            }
        }
        return missing;
    }
}
